# ─── BharatSetu OTP Server Configuration ─────────────────────────
# Copy this file to .env and fill in your credentials

# SMS Provider: 'twilio' | 'fast2sms' | 'console'
# Start with 'console' to test without SMS credits
SMS_PROVIDER=console

# Server port
VITE_OTP_SERVER_PORT=5000

# CORS origin (your Vite dev server)
CORS_ORIGIN=http://localhost:5173

# ─── Twilio (Free trial: https://www.twilio.com/try-twilio) ──────
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Fast2SMS (Indian SMS gateway, cheaper for India) ────────────
# Get API key from https://www.fast2sms.com
FAST2SMS_API_KEY=
